# Banco de dados
DB_NAME=Angel_Origamis
DB_USER=angel
DB_PASS=
DB_HOST=127.0.0.1

# Autenticação
JWT_SECRET=
PORT=3001

# Upload de imagens de produtos em produção (aponta para a pasta servida pelo Nginx).
# Deixe em branco em desenvolvimento local.
PRODUCTS_UPLOAD_DIR=

# Notificação por e-mail de novos pedidos/mensagens (opcional).
# Se qualquer uma dessas variáveis não estiver definida, as notificações
# são simplesmente puladas (não quebra a criação de pedidos/mensagens).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Angel Origamis <noreply@angelorigamis.com.br>"
ADMIN_NOTIFICATION_EMAIL=
